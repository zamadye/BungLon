# =============================================================================
# Konfigurasi build web (HideSeek Online) — salin ke ".env" lalu:
#   node tools/gen_web_config.js        -> menulis web/config.js (di-gitignore)
# Semua nilai boleh dikosongkan: kalau kosong, AdsManager jalan dalam MODE SIMULASI.
# ==========================================================================

# ---------- nama & tautan ----------
GAME_NAME=HideSeek Online

# ---------- AppLixir (Google Ad Placement API) ----------
APPLIXIR_PLACEMENT=rewarded_video
# slot per reward: "extra_life:slotA,bonus_coins:slotB"  (atau AD_UNITS_JSON={...})
APPLIXIR_AD_UNITS=
# AD_UNITS_JSON={"extra_life":"ca-pub-000000:reward_life","bonus_coins":"ca-pub-000000:reward_coins"}

# ---------- AdinPlay ----------
ADINPLAY_PLACEMENT=rewarded_placement

# ---------- perilaku iklan ----------
ADS_PLATFORM_ORDER=applixir,adinplay
ADS_TEST_MODE=true              # false saat rilis (pakai SDK asli)
ADS_COOLDOWN_SECONDS=30         # jeda global antar iklan (localStorage lastAdTime)
ADS_SIM_SECONDS=1.5             # durasi iklan simulasi
ADS_TIMEOUT_SECONDS=20          # tidak ada callback SDK -> no-fill -> fallback
ADS_COOLDOWN_KEY=lastAdTime

# ---------- referral ----------
REFERRAL_BASE_URL=              # mis. https://example.com/hideseek  (link => ?ref=KODE)
REFERRAL_COINS_INVITEE=50
REFERRAL_HP_INVITEE=1
REFERRAL_COINS_INVITER=100
REFERRAL_CODE_LENGTH=7
REFERRAL_WELCOME_SECONDS=6

# ---------- backend akun (server/api.js: JWT login/signup + referral + teman) ----------
# PHOTON_APP_ID/PHOTON_REGION di bawah = proyek PUN yang sama dengan yang dipakai Unity
# (sumber kebenaran: Assets/Scripts/Core/HideSeekConstants.cs -> PhotonAppId/PhotonRegion).
API_BASE_URL=                     # kosong = same-origin; node web/net-server.js sudah melayani /api
API_TIMEOUT_MS=6000
API_AUTO_SYNC=true                # kirim skor/koin ke server tiap akhir ronde
JWT_SECRET=                       # kosong -> dibuat otomatis di server/data/.secret
JWT_TTL_DAYS=30
DATA_DIR=                         # folder db.json (default: server/data)
PORT=3000                         # port utk "node server/api.js" (net-server.js pakai --port)
REF_COINS_INVITER=100             # dibayar SERVER saat akun baru daftar pakai ?ref=
REF_COINS_INVITEE=50
REF_HP_INVITEE=1
ADS_DAILY_CAP=20                  # batas klaim reward iklan per jenis per hari (server)
REF_CODE_LENGTH=7                 # panjang kode referral (samakan dengan charset referralSystem.js)
PASS_MIN=4                        # minimum panjang kata sandi (saat rilis naikkan ke 8)
LEADERBOARD_LEVEL=0               # 1 = /api/leaderboard boleh dibaca tanpa login (default), 0 = disembunyikan

# ---------- Unity: Photon PUN 2 (dipakai Assets/Scripts/Core/HideSeekConstants.cs) ----------
PHOTON_APP_ID=644b49fc-42a6-4a58-a247-163ae36caa12
PHOTON_REGION=asia                # kosongkan = Best Region (lihat README bagian 1)

# ---------- ekonomi profil (localStorage hideseek_profile) ----------
ECONOMY_START_COINS=0
ECONOMY_COINS_PER_SCORE=0.5
ECONOMY_MAXHP_PRICE=50
ECONOMY_MAXHP_CAP=2
ECONOMY_LIFE_PRICE=25
